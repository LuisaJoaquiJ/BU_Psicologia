// Modelo de datos de Conecta BU segun el diccionario de datos de F-03 (seccion 2.3).
// Sprint 1 solo usa Usuario y Rol; el resto de tablas se deja listo para los siguientes sprints.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tabla semilla (no enum fijo): permite agregar roles en el futuro sin migracion de esquema.
model Rol {
  id       String    @id @default(uuid())
  nombre   String    @unique @db.VarChar(50)
  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  id                 String    @id @default(uuid())
  emailInstitucional String    @unique @db.VarChar(120)
  nombre             String    @db.VarChar(200)
  rolId              String
  rol                Rol       @relation(fields: [rolId], references: [id])
  habilitado         Boolean   @default(true)
  // Pregrado, Posgrado o Egresado (RN-002 de Deporte). Vacio = Pregrado.
  categoriaEstudiante String?  @db.VarChar(15)
  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime  @updatedAt

  citasDesarrollo              CitaDesarrollo[]
  citasSalud                   CitaSalud[]
  inscripciones                Inscripcion[]
  asistenciasCitaRegistradas   AsistenciaCitaDesarrollo[] @relation("registradoPorCita")
  asistenciasCitaSaludRegistradas AsistenciaCitaSalud[]   @relation("registradoPorCitaSalud")
  asistenciasEventoRegistradas AsistenciaEvento[] @relation("registradoPorEvento")
  alertas                      AlertaInApp[]
  historial                    HistorialEstado[]
  atencionesSaludRegistradas   AtencionSalud[]    @relation("atencionSaludRegistradaPor")
  evidenciasSaludSubidas       EvidenciaSalud[]   @relation("evidenciaSaludSubidaPor")
  reportesSst                  ReporteSST[]       @relation("reporteSstReportadoPor")
  inscripcionesDeporte         InscripcionDeporte[]
  asistenciasDeporte           AsistenciaDeporte[]
  horasDeporteManuales         HoraDeporteManual[]
  inscripcionesSalida          InscripcionSalida[]
  inscripcionesEventoDeporte   InscripcionEventoDeporte[]

  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// Agenda de citas de Desarrollo Humano (orientacion). Salud integral tiene
// sus propias tablas (ServicioSalud, HorarioSalud, CitaSalud...): ningun
// modulo comparte datos con otro.
// ---------------------------------------------------------------------------
model ServicioDesarrollo {
  id            String               @id @default(uuid())
  nombre        String               @db.VarChar(150)
  descripcion   String?              @db.Text
  activo        Boolean              @default(true)
  fechaCreacion DateTime             @default(now())
  horarios      HorarioDesarrollo[]

  @@map("servicios_desarrollo")
}

model HorarioDesarrollo {
  id            String             @id @default(uuid())
  servicioId    String
  servicio      ServicioDesarrollo @relation(fields: [servicioId], references: [id])
  fecha         DateTime           @db.Date
  horaInicio    DateTime           @db.Time()
  horaFin       DateTime           @db.Time()
  cupo          Int                @default(1)
  ocupado       Boolean            @default(false)
  // Horario creado al registrar una atencion sin cita (el estudiante llego
  // sin agendar): no se muestra en la lista de horarios publicados.
  sinCita       Boolean            @default(false)
  fechaCreacion DateTime           @default(now())
  citas         CitaDesarrollo[]

  @@map("horarios_desarrollo")
}

// Tiempo en que el personal no atiende citas: compromiso institucional,
// incapacidad, permiso laboral, salida institucional, etc. Mientras dure,
// los horarios que se crucen no se ofrecen a los estudiantes.
model BloqueoDesarrollo {
  id            String    @id @default(uuid())
  fechaInicio   DateTime  @db.Date
  fechaFin      DateTime  @db.Date
  todoElDia     Boolean   @default(true)
  horaInicio    DateTime? @db.Time()
  horaFin       DateTime? @db.Time()
  motivo        String    @db.VarChar(60)
  detalle       String?   @db.VarChar(300)
  creadoPor     String?   @db.VarChar(200)
  fechaCreacion DateTime  @default(now())

  @@index([fechaInicio])
  @@map("bloqueos_desarrollo")
}

enum EstadoCita {
  Agendada
  Cancelada
  Atendida
  NoAsistio
}

model CitaDesarrollo {
  id                 String            @id @default(uuid())
  usuarioId          String
  usuario            Usuario           @relation(fields: [usuarioId], references: [id])
  horarioId          String
  horario            HorarioDesarrollo @relation(fields: [horarioId], references: [id])
  estado             EstadoCita        @default(Agendada)
  fechaAgendamiento  DateTime          @default(now())
  observaciones      String?           @db.Text
  fechaActualizacion DateTime          @updatedAt

  asistencia AsistenciaCitaDesarrollo?
  historial  HistorialEstado[]

  @@map("citas_desarrollo")
}

model AsistenciaCitaDesarrollo {
  id              String         @id @default(uuid())
  citaId          String         @unique
  cita            CitaDesarrollo @relation(fields: [citaId], references: [id])
  asistio         Boolean
  registradoPorId String
  registradoPor   Usuario        @relation("registradoPorCita", fields: [registradoPorId], references: [id])
  fechaRegistro   DateTime       @default(now())

  @@map("asistencias_cita_desarrollo")
}

// ---------------------------------------------------------------------------
// Agenda de citas de Salud integral (enfermeria, medicina...).
// ---------------------------------------------------------------------------
model ServicioSalud {
  id            String         @id @default(uuid())
  nombre        String         @db.VarChar(150)
  descripcion   String?        @db.Text
  activo        Boolean        @default(true)
  fechaCreacion DateTime       @default(now())
  horarios      HorarioSalud[]

  @@map("servicios_salud")
}

model HorarioSalud {
  id            String        @id @default(uuid())
  servicioId    String
  servicio      ServicioSalud @relation(fields: [servicioId], references: [id])
  fecha         DateTime      @db.Date
  horaInicio    DateTime      @db.Time()
  horaFin       DateTime      @db.Time()
  cupo          Int           @default(1)
  ocupado       Boolean       @default(false)
  sinCita       Boolean       @default(false)
  fechaCreacion DateTime      @default(now())
  citas         CitaSalud[]

  @@map("horarios_salud")
}

model BloqueoSalud {
  id            String    @id @default(uuid())
  fechaInicio   DateTime  @db.Date
  fechaFin      DateTime  @db.Date
  todoElDia     Boolean   @default(true)
  horaInicio    DateTime? @db.Time()
  horaFin       DateTime? @db.Time()
  motivo        String    @db.VarChar(60)
  detalle       String?   @db.VarChar(300)
  creadoPor     String?   @db.VarChar(200)
  fechaCreacion DateTime  @default(now())

  @@index([fechaInicio])
  @@map("bloqueos_salud")
}

enum EstadoCitaSalud {
  Agendada
  Cancelada
  Atendida
  NoAsistio
}

model CitaSalud {
  id                 String          @id @default(uuid())
  usuarioId          String
  usuario            Usuario         @relation(fields: [usuarioId], references: [id])
  horarioId          String
  horario            HorarioSalud    @relation(fields: [horarioId], references: [id])
  estado             EstadoCitaSalud @default(Agendada)
  fechaAgendamiento  DateTime        @default(now())
  observaciones      String?         @db.Text
  fechaActualizacion DateTime        @updatedAt

  asistencia AsistenciaCitaSalud?

  @@map("citas_salud")
}

model AsistenciaCitaSalud {
  id              String    @id @default(uuid())
  citaId          String    @unique
  cita            CitaSalud @relation(fields: [citaId], references: [id])
  asistio         Boolean
  registradoPorId String
  registradoPor   Usuario   @relation("registradoPorCitaSalud", fields: [registradoPorId], references: [id])
  fechaRegistro   DateTime  @default(now())

  @@map("asistencias_cita_salud")
}

enum EstadoEvento {
  Borrador
  Publicado
  Cerrado
  Cancelado
}

model Evento {
  id                     String       @id @default(uuid())
  nombre                 String       @db.VarChar(200)
  descripcion            String?      @db.Text
  fecha                  DateTime     @db.Date
  horaInicio             DateTime     @db.Time()
  horaFin                DateTime     @db.Time()
  lugar                  String?      @db.VarChar(200)
  cupos                  Int
  fechaLimiteInscripcion DateTime     @db.Date
  estado                 EstadoEvento @default(Borrador)
  fechaCreacion          DateTime     @default(now())
  // Foto del evento (nombre del archivo en uploads/eventos). Opcional.
  imagen                 String?      @db.VarChar(120)
  // Presencial, Virtual o Hibrida. Si no es presencial lleva el enlace de
  // la reunion, que solo ven los estudiantes inscritos.
  modalidad              String       @default("Presencial") @db.VarChar(20)
  enlaceReunion          String?      @db.VarChar(500)

  inscripciones Inscripcion[]
  historial     HistorialEstado[]

  @@map("eventos")
}

enum EstadoInscripcion {
  Confirmada
  Cancelada
}

model Inscripcion {
  id               String            @id @default(uuid())
  usuarioId        String
  usuario          Usuario           @relation(fields: [usuarioId], references: [id])
  eventoId         String
  evento           Evento            @relation(fields: [eventoId], references: [id])
  estado           EstadoInscripcion @default(Confirmada)
  fechaInscripcion DateTime          @default(now())

  asistencia AsistenciaEvento?

  @@unique([usuarioId, eventoId])
  @@map("inscripciones")
}

model AsistenciaEvento {
  id              String      @id @default(uuid())
  inscripcionId   String      @unique
  inscripcion     Inscripcion @relation(fields: [inscripcionId], references: [id])
  asistio         Boolean
  registradoPorId String
  registradoPor   Usuario     @relation("registradoPorEvento", fields: [registradoPorId], references: [id])
  fechaRegistro   DateTime    @default(now())

  @@map("asistencias_evento")
}

enum TipoAlerta {
  CitaAgendada
  CitaCancelada
  EventoPublicado
  EventoProximo
  General
}

model AlertaInApp {
  id            String     @id @default(uuid())
  usuarioId     String
  usuario       Usuario    @relation(fields: [usuarioId], references: [id])
  mensaje       String     @db.Text
  tipo          TipoAlerta
  leida         Boolean    @default(false)
  fechaCreacion DateTime   @default(now())

  @@map("alertas_in_app")
}

model HistorialEstado {
  id             String   @id @default(uuid())
  citaId         String?
  cita           CitaDesarrollo? @relation(fields: [citaId], references: [id])
  eventoId       String?
  evento         Evento?  @relation(fields: [eventoId], references: [id])
  estadoAnterior String   @db.VarChar(50)
  estadoNuevo    String   @db.VarChar(50)
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id])
  fecha          DateTime @default(now())

  @@map("historial_estados")
}

// ---------------------------------------------------------------------------
// Modulo Salud integral: reemplaza el registro general (SPADIEZ), el
// formulario de atencion de enfermeria, el reporte SNIES y el informe de
// gestion. Una persona se registra una sola vez y luego basta su documento o
// codigo estudiantil para registrar cada atencion o asistencia.
// ---------------------------------------------------------------------------

enum TipoDocumento {
  CC
  TI
  CE
  PA
  RC
  OTRO
}

enum PoblacionSalud {
  Estudiante
  Docente
  Administrativo
  Egresado
  Externo
}

enum CategoriaActividadSalud {
  AtencionEnfermeria
  PromocionPrevencion
  CampanaSalud
  DonacionSangre
  MedicinaLaboral
  Otra
}

enum ExamenMedicoLaboral {
  Ingreso
  Egreso
  Periodico
  EnfasisAlturas
  PostIncapacidad
}

model PersonaSalud {
  id                  String         @id @default(uuid())
  tipoDocumento       TipoDocumento  @default(CC)
  numeroDocumento     String         @unique @db.VarChar(30)
  codigoEstudiantil   String?        @unique @db.VarChar(30)
  nombres             String         @db.VarChar(120)
  apellidos           String         @db.VarChar(120)
  telefono            String?        @db.VarChar(30)
  correo              String?        @db.VarChar(120)
  poblacion           PoblacionSalud @default(Estudiante)
  programa            String?        @db.VarChar(150)
  // Esta en la ultima lista de estudiantes activos que subio Salud.
  estudianteActivo    Boolean        @default(false)
  // Autorizacion de tratamiento de datos (Ley 1581 de 2012).
  consentimientoDatos Boolean        @default(false)
  fechaConsentimiento DateTime?
  fechaCreacion       DateTime       @default(now())
  fechaActualizacion  DateTime       @updatedAt

  atenciones AtencionSalud[]

  @@index([apellidos, nombres])
  @@index([estudianteActivo])
  @@map("salud_personas")
}

model ActividadSalud {
  id                   String                  @id @default(uuid())
  // Codigo de la actividad en el reporte SNIES, unico dentro del periodo.
  codigo               Int
  periodo              String                  @db.VarChar(10)
  nombre               String                  @db.VarChar(200)
  categoria            CategoriaActividadSalud
  tipoSnies            Int                     @default(1)
  fechaInicio          DateTime                @db.Date
  fechaFin             DateTime                @db.Date
  // Servicio continuo (atencion basica, telemedicina...) frente a una jornada puntual.
  permanente           Boolean                 @default(false)
  // Pide signos vitales y descripcion del evento (atencion de enfermeria).
  clinica              Boolean                 @default(false)
  meta                 Int?
  presupuesto          Int?
  horasDedicacion      Int?
  responsableDocumento String?                 @db.VarChar(30)
  avances              String?                 @db.Text
  dificultades         String?                 @db.Text
  aprendizajes         String?                 @db.Text
  pendientes           String?                 @db.Text
  observaciones        String?                 @db.Text
  activa               Boolean                 @default(true)
  // Publicacion para los estudiantes (jornadas y campanas con inscripcion).
  publicada            Boolean                 @default(false)
  descripcion          String?                 @db.Text
  lugar                String?                 @db.VarChar(200)
  horaInicio           String?                 @db.VarChar(5)
  horaFin              String?                 @db.VarChar(5)
  // Vacio = sin limite de cupos.
  cupos                Int?
  fechaCreacion        DateTime                @default(now())

  atenciones    AtencionSalud[]
  evidencias    EvidenciaSalud[]
  inscripciones InscripcionActividadSalud[]

  @@unique([periodo, codigo])
  @@map("salud_actividades")
}

// Inscripcion de un estudiante a una jornada o campana publicada. Al marcar
// la asistencia se registra la atencion (su participacion).
model InscripcionActividadSalud {
  id               String         @id @default(uuid())
  actividadId      String
  actividad        ActividadSalud @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  usuarioId        String
  personaId        String
  estado           String         @default("Inscrita") @db.VarChar(15)
  asistio          Boolean        @default(false)
  atencionId       String?
  fechaInscripcion DateTime       @default(now())

  @@unique([actividadId, usuarioId])
  @@index([usuarioId])
  @@map("salud_actividades_inscripciones")
}

model AtencionSalud {
  id                     String               @id @default(uuid())
  personaId              String
  persona                PersonaSalud         @relation(fields: [personaId], references: [id])
  actividadId            String
  actividad              ActividadSalud       @relation(fields: [actividadId], references: [id])
  fecha                  DateTime             @db.Date
  // Poblacion y programa al momento de la atencion (para los reportes).
  poblacion              PoblacionSalud
  programa               String?              @db.VarChar(150)
  examenLaboral          ExamenMedicoLaboral?
  insumo                 String?              @db.VarChar(200)
  tensionArterial        String?              @db.VarChar(15)
  frecuenciaCardiaca     Int?
  frecuenciaRespiratoria Int?
  pesoKg                 Float?
  tallaCm                Int?
  glucometria            String?              @db.VarChar(20)
  descripcion            String?              @db.Text
  remitido               Boolean              @default(false)
  origen                 String               @default("registro") @db.VarChar(20)
  registradoPorId        String?
  registradoPor          Usuario?             @relation("atencionSaludRegistradaPor", fields: [registradoPorId], references: [id])
  fechaRegistro          DateTime             @default(now())

  @@index([fecha])
  @@index([personaId])
  @@index([actividadId])
  @@map("salud_atenciones")
}

model EvidenciaSalud {
  id            String         @id @default(uuid())
  actividadId   String
  actividad     ActividadSalud @relation(fields: [actividadId], references: [id])
  fecha         DateTime       @db.Date
  descripcion   String?        @db.VarChar(300)
  nombreArchivo String         @db.VarChar(255)
  ruta          String         @db.VarChar(400)
  tipoMime      String         @db.VarChar(100)
  tamanoBytes   Int
  subidoPorId   String?
  subidoPor     Usuario?       @relation("evidenciaSaludSubidaPor", fields: [subidoPorId], references: [id])
  fechaSubida   DateTime       @default(now())

  @@index([actividadId])
  @@map("salud_evidencias")
}

// ---------------------------------------------------------------------------
// Acceso del personal a cada modulo de Conecta BU. Los modulos (Desarrollo
// humano y orientacion, Salud integral, ...) son independientes: el
// superadministrador asigna por correo quien entra a cada uno. Se guarda por
// correo para poder asignar a alguien antes de su primer inicio de sesion.
// ---------------------------------------------------------------------------
model AccesoModulo {
  id              String   @id @default(uuid())
  email           String   @db.VarChar(120)
  modulo          String   @db.VarChar(40)
  asignadoPor     String?  @db.VarChar(120)
  fechaAsignacion DateTime @default(now())

  @@unique([email, modulo])
  @@index([email])
  @@map("accesos_modulo")
}

// ---------------------------------------------------------------------------
// Salidas institucionales y reportes SST (Salud integral). Reemplaza el
// formulario de Google "0 SALUD INTEGRAL": salidas con estudiantes (local,
// regional, nacional, internacional), salidas en representacion de la
// Institucion, traslados de docentes de posgrados y condiciones inseguras.
// Lo diligencia cualquier persona de la Institucion y lo revisa el personal
// de Salud (verificacion de documentos, reporte a la ARL o ASIST CARD).
// ---------------------------------------------------------------------------

enum TipoReporteSST {
  SalidaEstudiantesLocal
  SalidaEstudiantesRegional
  SalidaEstudiantesNacional
  SalidaEstudiantesInternacional
  RepresentacionNacional
  RepresentacionInternacional
  TrasladoPosgrados
  CondicionInsegura
}

enum EstadoReporteSST {
  Recibido
  Verificado
  RequiereAjustes
  Cerrado
}

enum MedioTransporteSST {
  Publico
  Particular
  Institucional
  Aereo
  Caminando
}

model ReporteSST {
  id                   String              @id @default(uuid())
  consecutivo          Int                 @unique @default(autoincrement())
  tipo                 TipoReporteSST
  estado               EstadoReporteSST    @default(Recibido)
  reportadoPorId       String
  reportadoPor         Usuario             @relation("reporteSstReportadoPor", fields: [reportadoPorId], references: [id])
  // Datos de quien reporta.
  correo               String              @db.VarChar(120)
  nombreReporta        String              @db.VarChar(200)
  celular              String              @db.VarChar(30)
  area                 String              @db.VarChar(120)
  // Quien viaja o el docente a cargo, y los demas (colaboradores o docentes).
  responsableNombre    String?             @db.VarChar(200)
  responsableTipoDoc   String?             @db.VarChar(5)
  responsableDocumento String?             @db.VarChar(30)
  acompanantes         Json?
  numeroEstudiantes    Int?
  // La salida o el traslado.
  evento               String?             @db.VarChar(200)
  motivo               String?             @db.Text
  pais                 String?             @db.VarChar(80)
  ciudadOrigen         String?             @db.VarChar(120)
  destino              String?             @db.VarChar(200)
  lugarDestino         String?             @db.VarChar(200)
  fechaSalida          DateTime?           @db.Date
  fechaRegreso         DateTime?           @db.Date
  horaSalida           String?             @db.VarChar(5)
  horaRegreso          String?             @db.VarChar(5)
  medioTransporte      MedioTransporteSST?
  transporteEmpresa    String?             @db.VarChar(200)
  conductor            String?             @db.VarChar(200)
  placa                String?             @db.VarChar(15)
  // Condicion insegura.
  lugarEvento          String?             @db.VarChar(200)
  fechaEvento          DateTime?           @db.Date
  horaEvento           String?             @db.VarChar(5)
  afectado             String?             @db.VarChar(200)
  cargo                String?             @db.VarChar(120)
  descripcion          String?             @db.Text
  clasificacion        String?             @db.VarChar(30)
  potencial            String?             @db.VarChar(10)
  medidaControl        String?             @db.Text
  // Anticipacion con la que se reporto la salida (3 o 5 dias segun el tipo).
  diasAnticipacion     Int?
  fueraDeTiempo        Boolean             @default(false)
  consentimientoDatos  Boolean             @default(false)
  // Revision del personal de Salud.
  gestionExterna       Boolean             @default(false)
  observacionRevision  String?             @db.Text
  revisadoPor          String?             @db.VarChar(120)
  fechaRevision        DateTime?
  fechaCreacion        DateTime            @default(now())
  fechaActualizacion   DateTime            @updatedAt

  adjuntos     AdjuntoReporteSST[]
  convocatoria SalidaConvocatoria?

  @@index([estado])
  @@index([fechaSalida])
  @@index([reportadoPorId])
  @@map("sst_reportes")
}

model AdjuntoReporteSST {
  id            String     @id @default(uuid())
  reporteId     String
  reporte       ReporteSST @relation(fields: [reporteId], references: [id], onDelete: Cascade)
  // Licencia, TarjetaPropiedad, Tecnomecanica, Soat, Vuelo, Movilidad, Poliza, Listado, Evidencia.
  tipo          String     @db.VarChar(40)
  nombreArchivo String     @db.VarChar(255)
  ruta          String     @db.VarChar(400)
  tipoMime      String     @db.VarChar(100)
  tamanoBytes   Int
  subidoPorId   String?
  fechaSubida   DateTime   @default(now())

  @@index([reporteId])
  @@map("sst_adjuntos")
}

// ---------------------------------------------------------------------------
// Informe de gestion (formato INFBI-002 "Direccionamiento estrategico"):
// hojas PROYECTO e INFORME - EVALUACION, mas la matriz de atendidos, las
// estadisticas y el registro fotografico que se calculan de lo registrado.
// El modulo lo prepara y lo envia al superadministrador, que lo descarga en
// PDF o Excel y lo aprueba o lo devuelve con observaciones.
// ---------------------------------------------------------------------------

enum EstadoInformeGestion {
  Borrador
  Enviado
  Devuelto
  Aprobado
}

model InformeGestion {
  id                  String               @id @default(uuid())
  modulo              String               @default("salud") @db.VarChar(40)
  periodo             String               @db.VarChar(10)
  fechaPresentacion   DateTime?            @db.Date
  responsable         String?              @db.VarChar(200)
  accionMejora        Boolean              @default(true)
  accionCorrectiva    Boolean              @default(true)
  accionPreventiva    Boolean              @default(true)
  descripcion         String?              @db.Text
  justificacion       String?              @db.Text
  alineacion          String?              @db.Text
  // [{ objetivo, resultado, beneficio }]
  objetivos           Json?
  logros              String?              @db.Text
  dificultades        String?              @db.Text
  accionesMejora      String?              @db.Text
  estado              EstadoInformeGestion @default(Borrador)
  version             Int                  @default(0)
  enviadoPor          String?              @db.VarChar(120)
  fechaEnvio          DateTime?
  observacionRevision String?              @db.Text
  revisadoPor         String?              @db.VarChar(120)
  fechaRevision       DateTime?
  // Cifras calculadas en el momento del envio (lo que recibe el superadministrador).
  datosEnviados       Json?
  fechaCreacion       DateTime             @default(now())
  fechaActualizacion  DateTime             @updatedAt

  @@unique([modulo, periodo])
  @@map("informes_gestion")
}

// Cifras de años anteriores (hoja "ESTADISTICAS POBLACION ATENDIDA"), para
// comparar con lo que ya se registra en Conecta BU.
model HistoricoSalud {
  id               String @id @default(uuid())
  periodo          String @unique @db.VarChar(10)
  estudiantes      Int    @default(0)
  docentes         Int    @default(0)
  administrativos  Int    @default(0)
  externos         Int    @default(0)
  egresados        Int    @default(0)
  enfermeria       Int?
  poblacionGeneral Int?

  @@map("salud_historicos")
}

// ---------------------------------------------------------------------------
// Modulo Deporte: la Universidad oferta disciplinas (natacion, running,
// voleibol, futbol, ajedrez...) en grupos con horario por periodo. Los
// estudiantes se inscriben y acumulan horas con la asistencia que registra
// el instructor (o con horas que el personal reconoce por torneos y
// eventos) hasta completar las horas requeridas (40 por defecto).
// ---------------------------------------------------------------------------

model DisciplinaDeportiva {
  id            String   @id @default(uuid())
  nombre        String   @unique @db.VarChar(80)
  descripcion   String?  @db.Text
  tipo          String   @default("Individual") @db.VarChar(30)
  // Categorias que pueden inscribirse (RN-002). Vacio = todas.
  categorias    String[] @default([])
  activa        Boolean  @default(true)
  // Foto de portada (nombre del archivo en uploads/deporte/disciplinas).
  imagen        String?  @db.VarChar(120)
  fechaCreacion DateTime @default(now())

  grupos        GrupoDeporte[]
  horasManuales HoraDeporteManual[]
  eventos       EventoDeporte[]
  alertas       AlertaDeporte[]
  implementos   ImplementoDeporte[]

  @@map("deporte_disciplinas")
}

model GrupoDeporte {
  id                    String              @id @default(uuid())
  disciplinaId          String
  disciplina            DisciplinaDeportiva @relation(fields: [disciplinaId], references: [id])
  periodo               String              @db.VarChar(10)
  nombre                String              @db.VarChar(80)
  instructor            String?             @db.VarChar(150)
  // Docente asignado (RF-007): solo el ve y registra la asistencia del grupo.
  docenteId             String?
  docente               DocenteDeporte?     @relation(fields: [docenteId], references: [id])
  lugar                 String?             @db.VarChar(150)
  cupo                  Int                 @default(25)
  // [{ dia: 1 (lunes) a 7 (domingo), inicio: "HH:mm", fin: "HH:mm" }]
  horario               Json
  inscripcionesAbiertas Boolean             @default(true)
  activo                Boolean             @default(true)
  fechaCreacion         DateTime            @default(now())

  inscripciones InscripcionDeporte[]
  sesiones      SesionDeporte[]
  alertas       AlertaDeporte[]

  @@index([periodo])
  @@index([docenteId])
  @@map("deporte_grupos")
}

model InscripcionDeporte {
  id               String       @id @default(uuid())
  grupoId          String
  grupo            GrupoDeporte @relation(fields: [grupoId], references: [id])
  usuarioId        String
  usuario          Usuario      @relation(fields: [usuarioId], references: [id])
  estado           String       @default("Activa") @db.VarChar(15)
  fechaInscripcion DateTime     @default(now())
  fechaRetiro      DateTime?

  @@unique([grupoId, usuarioId])
  @@index([usuarioId])
  @@map("deporte_inscripciones")
}

model SesionDeporte {
  id            String       @id @default(uuid())
  grupoId       String
  grupo         GrupoDeporte @relation(fields: [grupoId], references: [id])
  fecha         DateTime     @db.Date
  inicio        String       @db.VarChar(5)
  fin           String       @db.VarChar(5)
  horas         Float
  tema          String?      @db.VarChar(200)
  registradaPor String?      @db.VarChar(120)
  fechaRegistro DateTime     @default(now())

  asistencias AsistenciaDeporte[]

  @@unique([grupoId, fecha, inicio])
  @@map("deporte_sesiones")
}

model AsistenciaDeporte {
  id        String        @id @default(uuid())
  sesionId  String
  sesion    SesionDeporte @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario       @relation(fields: [usuarioId], references: [id])
  presente  Boolean       @default(true)

  @@unique([sesionId, usuarioId])
  @@index([usuarioId])
  @@map("deporte_asistencias")
}

// Horas reconocidas por el personal (torneos, representacion, eventos).
model HoraDeporteManual {
  id            String               @id @default(uuid())
  usuarioId     String
  usuario       Usuario              @relation(fields: [usuarioId], references: [id])
  disciplinaId  String?
  disciplina    DisciplinaDeportiva? @relation(fields: [disciplinaId], references: [id])
  fecha         DateTime             @db.Date
  horas         Float
  motivo        String               @db.VarChar(200)
  registradoPor String?              @db.VarChar(120)
  fechaRegistro DateTime             @default(now())

  @@index([usuarioId])
  @@map("deporte_horas_manuales")
}

// Docentes / entrenadores (RF-004). Su correo recibe el acceso
// "deporte-docente": entran a su panel y solo ven sus grupos (RN-004).
model DocenteDeporte {
  id            String   @id @default(uuid())
  email         String   @unique @db.VarChar(120)
  nombre        String   @db.VarChar(150)
  telefono      String?  @db.VarChar(30)
  especialidad  String?  @db.VarChar(120)
  activo        Boolean  @default(true)
  fechaCreacion DateTime @default(now())

  grupos GrupoDeporte[]

  @@map("deporte_docentes")
}

// Eventos deportivos puntuales: torneos, masterclasses, jornadas (RF-002).
model EventoDeporte {
  id               String               @id @default(uuid())
  nombre           String               @db.VarChar(150)
  tipo             String               @default("Torneo") @db.VarChar(30)
  descripcion      String?              @db.Text
  disciplinaId     String?
  disciplina       DisciplinaDeportiva? @relation(fields: [disciplinaId], references: [id])
  fecha            DateTime             @db.Date
  horaInicio       String               @db.VarChar(5)
  horaFin          String               @db.VarChar(5)
  lugar            String?              @db.VarChar(150)
  cupo             Int?
  fechaLimite      DateTime?            @db.Date
  // Horas de deporte que se reconocen a quien asiste.
  horasReconocidas Float?
  categorias       String[]             @default([])
  estado           String               @default("Publicado") @db.VarChar(15)
  creadoPor        String?              @db.VarChar(120)
  imagen           String?              @db.VarChar(120)
  fechaCreacion    DateTime             @default(now())

  inscripciones InscripcionEventoDeporte[]

  @@index([fecha])
  @@map("deporte_eventos")
}

model InscripcionEventoDeporte {
  id               String        @id @default(uuid())
  eventoId         String
  evento           EventoDeporte @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuarioId        String
  usuario          Usuario       @relation(fields: [usuarioId], references: [id])
  estado           String        @default("Activa") @db.VarChar(15)
  asistio          Boolean?
  fechaInscripcion DateTime      @default(now())

  @@unique([eventoId, usuarioId])
  @@index([usuarioId])
  @@map("deporte_eventos_inscripciones")
}

// Comunicados del area de Deportes (RF-011) a todos, a una disciplina o a un grupo.
model AlertaDeporte {
  id           String               @id @default(uuid())
  titulo       String               @db.VarChar(120)
  mensaje      String               @db.Text
  prioridad    String               @default("Informativa") @db.VarChar(15)
  alcance      String               @default("Todos") @db.VarChar(15)
  disciplinaId String?
  disciplina   DisciplinaDeportiva? @relation(fields: [disciplinaId], references: [id])
  grupoId      String?
  grupo        GrupoDeporte?        @relation(fields: [grupoId], references: [id])
  autor        String?              @db.VarChar(150)
  autorEmail   String?              @db.VarChar(120)
  vigenteHasta DateTime?            @db.Date
  imagen       String?              @db.VarChar(120)
  fecha        DateTime             @default(now())

  @@index([fecha])
  @@map("deporte_alertas")
}

// Inventario de implementos deportivos: existencias, prestamos y movimientos.
// Disponibles = cantidadTotal - cantidadDanada - prestados sin devolver.
model ImplementoDeporte {
  id             String               @id @default(uuid())
  codigo         String?              @unique @db.VarChar(30)
  nombre         String               @db.VarChar(120)
  descripcion    String?              @db.Text
  disciplinaId   String?
  disciplina     DisciplinaDeportiva? @relation(fields: [disciplinaId], references: [id])
  ubicacion      String?              @db.VarChar(120)
  cantidadTotal  Int                  @default(0)
  cantidadDanada Int                  @default(0)
  stockMinimo    Int                  @default(0)
  activo         Boolean              @default(true)
  imagen         String?              @db.VarChar(120)
  fechaCreacion  DateTime             @default(now())

  prestamos   PrestamoImplemento[]
  movimientos MovimientoInventario[]

  @@map("deporte_implementos")
}

model PrestamoImplemento {
  id                      String            @id @default(uuid())
  implementoId            String
  implemento              ImplementoDeporte @relation(fields: [implementoId], references: [id])
  cantidad                Int
  // Estudiante, Docente, Grupo u Otro.
  tipoResponsable         String            @db.VarChar(15)
  responsable             String            @db.VarChar(150)
  responsableEmail        String?           @db.VarChar(120)
  grupoId                 String?
  fechaPrestamo           DateTime          @default(now())
  fechaDevolucionEsperada DateTime          @db.Date
  fechaDevolucion         DateTime?
  devueltosBien           Int?
  devueltosDanados        Int?
  perdidos                Int?
  observacion             String?           @db.VarChar(300)
  registradoPor           String?           @db.VarChar(120)

  @@index([implementoId])
  @@map("deporte_prestamos")
}

model MovimientoInventario {
  id            String            @id @default(uuid())
  implementoId  String
  implemento    ImplementoDeporte @relation(fields: [implementoId], references: [id])
  // Ingreso, Baja, Ajuste, Prestamo, Devolucion, Reparacion.
  tipo          String            @db.VarChar(15)
  cantidad      Int
  motivo        String?           @db.VarChar(300)
  registradoPor String?           @db.VarChar(120)
  fecha         DateTime          @default(now())

  @@index([implementoId])
  @@map("deporte_movimientos_inventario")
}

model ConfigDeporte {
  id                  Int @id @default(1)
  horasRequeridas     Int @default(40)
  maxGruposPorPeriodo Int @default(2)

  @@map("deporte_config")
}

// ---- Salud integral: salidas con inscripcion de estudiantes ------------------
// El personal de Salud publica la salida (visita tecnica, practica...) y los
// estudiantes se inscriben con sus datos, EPS y, si se pide, el comprobante de
// pago. Con los inscritos aprobados se arma el listado para la ARL o el seguro.
model SalidaConvocatoria {
  id                     String    @id @default(uuid())
  nombre                 String    @db.VarChar(200)
  descripcion            String?   @db.Text
  destino                String    @db.VarChar(200)
  programa               String?   @db.VarChar(150)
  responsable            String?   @db.VarChar(200)
  lugarEncuentro         String?   @db.VarChar(200)
  fechaSalida            DateTime  @db.Date
  fechaRegreso           DateTime  @db.Date
  horaSalida             String?   @db.VarChar(5)
  horaRegreso            String?   @db.VarChar(5)
  cupos                  Int
  costo                  Int?
  infoPago               String?   @db.Text
  pideComprobante        Boolean   @default(false)
  fechaLimiteInscripcion DateTime  @db.Date
  estado                 String    @default("Borrador") @db.VarChar(15)
  creadaPor              String?   @db.VarChar(120)
  // Reporte SST de la salida de estudiantes de la que nacio la convocatoria.
  reporteSstId           String?   @unique
  reporteSst             ReporteSST? @relation(fields: [reporteSstId], references: [id], onDelete: SetNull)
  fechaCreacion          DateTime  @default(now())
  fechaActualizacion     DateTime  @updatedAt

  inscripciones InscripcionSalida[]

  @@index([estado, fechaSalida])
  @@map("salud_salidas")
}

model InscripcionSalida {
  id                 String             @id @default(uuid())
  salidaId           String
  salida             SalidaConvocatoria @relation(fields: [salidaId], references: [id])
  usuarioId          String
  usuario            Usuario            @relation(fields: [usuarioId], references: [id])
  nombre             String             @db.VarChar(200)
  correo             String             @db.VarChar(120)
  tipoDocumento      String             @default("CC") @db.VarChar(5)
  documento          String             @db.VarChar(30)
  programa           String             @db.VarChar(150)
  celular            String             @db.VarChar(30)
  eps                String             @db.VarChar(120)
  contactoEmergencia String?            @db.VarChar(200)
  telefonoEmergencia String?            @db.VarChar(30)
  comprobante        String?            @db.VarChar(120)
  comprobanteNombre  String?            @db.VarChar(200)
  estado             String             @default("Pendiente") @db.VarChar(15)
  observacion        String?            @db.Text
  consentimiento     Boolean            @default(false)
  revisadoPor        String?            @db.VarChar(120)
  fechaRevision      DateTime?
  fechaInscripcion   DateTime           @default(now())
  fechaActualizacion DateTime           @updatedAt

  @@unique([salidaId, usuarioId])
  @@index([usuarioId])
  @@map("salud_salidas_inscripciones")
}
