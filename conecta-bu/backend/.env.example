# Puerto donde corre la API
PORT=4000

# Cadena de conexion a PostgreSQL (local, Docker o Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/conecta_bu?schema=public"

# Firma de los JWT propios de Conecta BU (cambiar por un valor largo y aleatorio)
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1h"

# Client ID de OAuth 2.0 creado en Google Cloud Console (tipo "Web application")
GOOGLE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"

# Dominio institucional autorizado para iniciar sesion (RN-001)
ALLOWED_GOOGLE_DOMAIN="uniautonoma.edu.co"

# URL del frontend, usada para configurar CORS
FRONTEND_URL="http://localhost:5173"

# Limite de peticiones: intentos de login por IP cada 15 min y preguntas al
# asistente por usuario cada 5 min. Si el backend va detras de un proxy,
# define TRUST_PROXY (p. ej. 1) para que se cuente la IP real del usuario.
LIMITE_LOGIN=20
LIMITE_ASISTENTE=20
# TRUST_PROXY=1
