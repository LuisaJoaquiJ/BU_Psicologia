# URL base de la API (incluye /api/v1). En desarrollo, vite.config.js ya redirige
# /api hacia el backend, asi que puedes dejar esta variable vacia si usas el proxy.
VITE_API_URL=http://localhost:4000/api/v1

# Debe ser el MISMO Client ID configurado en el backend (GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
